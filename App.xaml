<Application x:Class="MediaController.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Global Theme Styles -->
            <SolidColorBrush x:Key="BgDark" Color="#1E1E2E"/>
            <SolidColorBrush x:Key="CardDark" Color="#2A2A3C"/>
            <SolidColorBrush x:Key="AccentColor" Color="#89B4FA"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A6ADC8"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
