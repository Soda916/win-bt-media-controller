<Window x:Class="MediaController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BT Media Controller"
        Height="95" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="MediaBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F435C"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F435C"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#313244" BorderThickness="1" Margin="6">
        <Border.ContextMenu>
            <ContextMenu Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#313244">
                <MenuItem Header="📋 複製除錯 Log (Copy Debug Log)" Click="MenuCopyLog_Click" Foreground="#CDD6F4"/>
                <MenuItem Header="🔄 重新掃描媒體會話" Click="BtnRefresh_Click" Foreground="#CDD6F4"/>
                <Separator Background="#313244"/>
                <MenuItem Header="🧹 清除 Log" Click="MenuClearLog_Click" Foreground="#A6ADC8"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 專輯封面 -->
            <Border Grid.Column="0" Width="60" Height="60" CornerRadius="8" Background="#181825" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="CoverPlaceholder" Text="🎵" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#585B70"/>
                    <Image x:Name="ImgCover" Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <!-- 歌曲與歌手資訊 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                <TextBlock x:Name="TxtTitle" Text="BT Media Controller" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="TxtArtist" Text="等待 iPhone 播放... (右鍵可複製 Log)" Foreground="#A6ADC8" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 控制按鈕區 -->
            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                <!-- 右上角小工具按鈕 (重新整理/置頂/縮小/關閉) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <Button x:Name="BtnRefresh" Content="🔄" Style="{StaticResource IconBtnStyle}" Click="BtnRefresh_Click" ToolTip="手動重新偵測"/>
                    <Button x:Name="BtnPin" Content="📌" Style="{StaticResource IconBtnStyle}" Click="BtnPin_Click" ToolTip="切換置頂"/>
                    <Button x:Name="BtnMin" Content="🗕" Style="{StaticResource IconBtnStyle}" Click="BtnMin_Click" ToolTip="縮小"/>
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource IconBtnStyle}" Click="BtnClose_Click" ToolTip="關閉"/>
                </StackPanel>

                <!-- 播放控制按鈕 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPrev" Content="⏮" Style="{StaticResource MediaBtnStyle}" Click="BtnPrev_Click" ToolTip="上一首 (Ctrl+Alt+Left)"/>
                    <Button x:Name="BtnPlayPause" Content="▶" Style="{StaticResource MediaBtnStyle}" Click="BtnPlayPause_Click" ToolTip="播放/暫停 (Ctrl+Alt+Space)" Margin="4,0"/>
                    <Button x:Name="BtnNext" Content="⏭" Style="{StaticResource MediaBtnStyle}" Click="BtnNext_Click" ToolTip="下一首 (Ctrl+Alt+Right)"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
